#!/usr/bin/env python
"""Generate the --in-console command database (scripts/console_db).

Pipeline: walk -> services -> intent heuristics -> URLs from snapshots
-> docs -> overrides -> export.  Offline and deterministic: the same
checkout, snapshots and overrides give byte-identical outputs.
"""

import argparse
import csv
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
DB_DIR = os.path.join(HERE, 'console_db')
SNAPSHOT_DIR = os.path.join(DB_DIR, 'snapshots')
DEFAULT_OUT = os.path.join(
    REPO, 'awscli', 'data', 'open_the_console_to_this', 'commands.json'
)


def read_tsv(path):
    with open(path, encoding='utf-8', newline='') as f:
        return list(csv.DictReader(f, delimiter='\t'))


def read_lines(path):
    with open(path, encoding='utf-8') as f:
        return [line.strip() for line in f if line.strip()]


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--out', default=DEFAULT_OUT, help='JSON database to write'
    )
    parser.add_argument(
        '--review-dir',
        default=os.path.join(DB_DIR, 'review'),
        help='directory for commands.csv and STATS.md',
    )
    parser.add_argument(
        '--snapshot-dir',
        default=SNAPSHOT_DIR,
        help='directory holding the resolver snapshots',
    )
    parser.add_argument(
        '--overrides-dir',
        default=os.path.join(DB_DIR, 'overrides'),
        help='directory holding the override YAML files',
    )
    parser.add_argument(
        '--snapshot-date',
        default=None,
        help='date recorded as generated.snapshot and url.verified '
        '(default: the snapshot directory\'s SNAPSHOT_DATE file)',
    )
    return parser.parse_args(argv)


def main(argv=None):
    sys.path.insert(0, HERE)
    from console_db import (
        docs,
        export,
        heuristics,
        overrides,
        services,
        urls_from_snapshots,
        walk,
    )

    import awscli
    from awscli.clidriver import create_clidriver

    args = parse_args(argv)
    snapshot_date = (
        args.snapshot_date
        or read_lines(os.path.join(args.snapshot_dir, 'SNAPSHOT_DATE'))[0]
    )

    def snap(name):
        return os.path.join(args.snapshot_dir, name)

    resource_types = read_lines(snap('resource-types.txt'))
    namespaces = sorted({t.split('::')[1] for t in resource_types})

    try:
        # 1. Walk this checkout's command tree.
        root = walk.walk_command_tree(create_clidriver())

        # 2. Service layer: console slug/scope/namespaces and home URLs;
        #    every tier-2/3 node starts on its service's home page.
        services.apply_service_layer(
            root,
            read_tsv(snap('services.tsv')),
            overrides.load_tier1_file(args.overrides_dir, 'services.yaml'),
            namespaces=namespaces,
            snapshot_date=snapshot_date,
        )

        # 3. Intent heuristics: verb, resource type, id options and match
        #    quality for every operation and waiter (other nodes keep None).
        type_index = heuristics.build_type_index(resource_types)
        for _name, service_node in walk.tier1_nodes(root):
            for node in walk.iter_nodes(service_node):
                if node['kind'] not in ('operation', 'waiter'):
                    continue
                intent, quality = heuristics.derive_intent(
                    node, service_node, type_index
                )
                node['intent'] = intent
                node['_intent_quality'] = quality

        # 4. URLs from snapshots: list/create pages and detail templates
        #    replace the service-home placeholders set in step 2.
        urls_from_snapshots.assign_urls(
            root,
            {
                'types': read_tsv(snap('types.tsv')),
                'view_by_id': read_tsv(snap('view-by-id.tsv')),
                'services': read_tsv(snap('services.tsv')),
            },
            snapshot_date=snapshot_date,
        )

        # 5. Documentation URLs.
        docs.assign_docs(
            root,
            read_tsv(snap('docs.tsv')),
            overrides.load_tier1_file(args.overrides_dir, 'docs.yaml'),
        )

        # 6. Hand edits win over everything generated.
        overrides.apply_overrides(
            root, overrides.load_overrides(args.overrides_dir)
        )
    except overrides.BuildError as e:
        sys.stderr.write(f'gen-console-db: {e}\n')
        return 1

    # 7. Export.
    meta = {
        'awscli': awscli.__version__,
        'snapshot': snapshot_date,
        'resource_types': len(resource_types),
    }
    export.write_json(root, meta, args.out)
    export.write_csv(root, os.path.join(args.review_dir, 'commands.csv'))
    export.write_stats(
        root, os.path.join(args.review_dir, 'STATS.md'), meta=meta
    )
    return 0


if __name__ == '__main__':
    sys.exit(main())
